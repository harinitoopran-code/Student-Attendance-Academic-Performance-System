<%@ page contentType="text/html;charset=UTF-8" %><link rel="stylesheet" href="css/style.css"><main><h2>Enter Internal Marks</h2><p>Use student_id and subject_id from MySQL tables.</p><form method="post" action="marks"><input type="number" name="studentId" placeholder="Student ID" required><input type="number" name="subjectId" placeholder="Subject ID" required><input name="assessment" placeholder="Internal 1" required><input type="number" name="marks" step="0.01" min="0" placeholder="Marks obtained" required><button>Save marks</button></form></main>