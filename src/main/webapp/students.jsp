<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><link rel="stylesheet" href="css/style.css"><main><h2>Students</h2><form method="post" action="students"><input name="roll" placeholder="Roll number" required><input name="name" placeholder="Student name" required><input name="department" placeholder="Department" required><input name="year" placeholder="Academic year" required><input name="section" placeholder="Section" required><button>Add student</button></form><% List<Map<String,Object>> a=(List<Map<String,Object>>)request.getAttribute("students");if(a!=null)for(Map<String,Object> x:a){%><p><%=x.get("roll")%> — <%=x.get("name")%> — <%=x.get("dept")%> — <%=x.get("year")%> — <%=x.get("section")%> <a href="report?studentId=<%=x.get("id")%>">Report</a></p><%}%></main>