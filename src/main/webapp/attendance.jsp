<%@ page contentType="text/html;charset=UTF-8" %><link rel="stylesheet" href="css/style.css"><main><h2>Mark Attendance</h2><p>Enter the student database ID (shown in MySQL students table), date and status.</p><form method="post" action="attendance"><input type="number" name="studentId" placeholder="Student ID" required><input type="date" name="date" required><select name="status"><option value="PRESENT">Present</option><option value="ABSENT">Absent</option></select><button>Save attendance</button></form><p><a href="students">View students</a></p></main>